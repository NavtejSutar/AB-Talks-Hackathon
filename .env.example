# Environment Configuration for Wren AI Security Researcher Persona

# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (Supabase PostgreSQL)
# Note: Ensure prepareThreshold=0 is included in the JDBC URL to prevent pgBouncer prepared statement conflicts
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<dbname>?prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# LLM Provider Priority Order & API Keys
LLM_PROVIDER_PRIORITY=gemini,groq,openrouter,cerebras
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

# Data Source API Credentials
GITHUB_TOKEN=
NVD_API_KEY=

# Internal Debug/Ops Endpoints Security Token
DEBUG_TOKEN=
