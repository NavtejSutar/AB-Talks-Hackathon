# .env.example — Copy this to .env and fill in your values.
# .env is gitignored and will never be committed.

# ── Spring Profile ──────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev

# ── Database ────────────────────────────────────────────────────────────────
# Local H2 (default — no DB needed):
# Leave SPRING_DATASOURCE_* unset for H2 in-memory.
#
# To connect to Supabase locally, set all three:
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?prepareThreshold=0&sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.YOURPROJECTREF
# SPRING_DATASOURCE_PASSWORD=your_supabase_password
# SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# ── LLM Providers ───────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# GROQ_API_KEY=your_groq_key_here
# OPENROUTER_API_KEY=your_openrouter_key_here
# CEREBRAS_API_KEY=your_cerebras_key_here
LLM_PROVIDER_PRIORITY=gemini,groq,openrouter,cerebras
GEMINI_REQUESTS_PER_MINUTE=5

# ── Discovery ───────────────────────────────────────────────────────────────
GITHUB_TOKEN=your_github_personal_access_token
NVD_API_KEY=your_nvd_api_key

# ── Security ─────────────────────────────────────────────────────────────────
DEBUG_TOKEN=local-dev-secret-token

# ── Scheduler ────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
